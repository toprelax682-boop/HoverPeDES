<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is referenced only for System.Windows.Automation (UI Automation client) -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HoverPeDES</AssemblyName>
    <RootNamespace>HoverPeDES</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hoverpedes.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>HoverPeDES</Company>
    <Product>HoverPeDES</Product>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\hoverpedes.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
